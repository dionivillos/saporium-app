{
  "expo": {
    "name": "Saporium",
    "slug": "saporium-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saporium",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dionivillos.saporium",
      "supportsTablet": true
    },
    "android": {
      "package": "com.dionivillos.saporium",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1EA",
          "dark": {
            "backgroundColor": "#151312"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Saporium usa tus fotos para ilustrar tus recetas. Las imágenes se guardan solo en tu dispositivo.",
          "cameraPermission": "Saporium usa la cámara para fotografiar tus recetas. Las imágenes se guardan solo en tu dispositivo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
